# Judgment. Get a key at https://typesafe.ai
TYPESAFE_API_KEY=

# Generation. `claude --bare` reads Anthropic auth ONLY from this variable —
# never OAuth credentials or the keychain.
ANTHROPIC_API_KEY=

# Optional. Pinned in code otherwise, so a model repoint cannot read as a
# skill regression.
# JEV_MODEL=jev-1.13.0
